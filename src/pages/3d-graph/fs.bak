precision highp float;

uniform vec2 iResolution;
uniform float iTime;
uniform vec3 iCameraPosition;
uniform vec3 iCameraDirection;

const vec3 WHITE = vec3(1.0);
const vec3 RED = vec3(1.0,0.0,0.0);
const vec3 BLUE = vec3(0.0,0.0,1.0);
const vec3 BLACK = vec3(0.0);

vec3 LIGHTPOS = vec3(0.,0.,1.);

vec4 grid(vec2 p, vec4 color) {
  // vec4 color = vec4(BLACK, 1.0);

  vec2 lineWidth = max(2./iResolution.xy, .0002 / abs(iCameraPosition.z) / 0.3);
  float lineSpacing = .25 / abs(iCameraPosition.z);
  float majorLineSpacing = .5 / abs(iCameraPosition.z);

  // xy-grid
  if (mod(p.x, lineSpacing) < lineWidth.x) {
    color.rgb = WHITE * smoothstep(0., 1., lineSpacing/mod(p.x, lineSpacing));
  }
  if (mod(p.y, lineSpacing) < lineWidth.y) {
    color.rgb = WHITE * smoothstep(0., 1., lineSpacing/mod(p.y, lineSpacing));
  }
  if (mod(p.x, majorLineSpacing) < lineWidth.x) {
    color.rgb = RED * smoothstep(0., 1., lineSpacing/mod(p.y, lineSpacing));
  }

  return vec4(color.rgb, 1.0);
}

void map(vec3 p, out vec4 color, out float d){
  // sdf for a sphere
  // p.z += 10.;
  // p.x = abs(p.x);

  float rad = 0.02;
  vec4 v = vec4(RED,0.);
  {
    vec3 p2 = p;
    p2.z *= 2.0;
    p2.y += sin(p2.x*20. + iTime)*.2;
    p2.x /= rad*1.0e4;
    v.w = length(p2)-rad;
  }
  vec4 h = vec4(BLUE,0.);
  {
    vec3 p2 = p;
    p2.y *= 2.0;
    p2.z += sin(p2.x*20. + iTime)*.2;
    p2.x /= rad*1.0e4;
    h.w = length(p2)-rad;
  }
  // vec4 hFill = vec4(BLUE,0.);

  // if (v.w < h.w) {
  //   color = vec4(v.rgb, 1.0);
  //   d = v.w;
  //   return;
  // }
  color = vec4(h.rgb, 1.0);
  d = v.w;
}

void render(vec3 ro, vec3 rd, out vec4 color, out float d){
  float dp = 0.;
  vec4 _color = vec4(0.);
  float _d = 10.;
  for (int i=0; i<300; i+=1){
    map(ro+rd*dp, _color, _d);
    if (d < 2e-4) {
      color = _color;
      d = _d;
      return;
      // return vec4(_color, _d);
    }
    dp+=_d/4.2;
  }
  // if the ray never hits anything, return 0 for distance
  d = 0.;
  color = vec4(0.);
  // return;
}

vec3 normal(vec3 pos) {
  vec4 color = vec4(0.);
  float d = 0.;
  map(pos, color, d);
  vec2 offset = vec2(0.001, 0.0);
  float d2 = 0.;
  float d3 = 0.;
  float d4 = 0.;
  map(pos + offset.xyy, color, d2);
  map(pos + offset.yxy, color, d3);
  map(pos + offset.yyx, color, d4);
  return normalize(vec3(
    d2,
    d3,
    d4
  ) - d);
}

// vec3 lightPos(float time){
//   // return vec3(sin(time), cos(time), 2. + sin(time)) * 10.;
//   // return vec3(sin(time)*20.,cos(time)*20.,0.1);
//   // return vec3(0.,5.,1.);
// }

vec3 lambert(vec3 color, vec3 p, vec3 eye) {
  const vec3 ambientLight = 0.35 * vec3(1.0, 1.0, 1.0);
  vec3 diffuse = ambientLight * color;

  vec3 lightIntensity = vec3(0.85, 0.85, 0.85);
  vec3 lightPos = vec3(0.,5.,1.);

  vec3 N = normal(p);
  vec3 L = normalize(lightPos - p);

  float dotLN = dot(L, N);
  // Light not visible from this point on the surface
  if (dotLN < 0.0) {
    return diffuse;
  }
  diffuse += dotLN * color * lightIntensity;
  return diffuse;
}

void main() {

  vec3 camPos = iCameraPosition;
  vec3 cameraDir = iCameraDirection;
  vec3 cameraTarget = camPos + vec3(cameraDir.x, cameraDir.y, cameraDir.z);
  float fov = 3.;
  // camPos.z = 5.;
  // float time = iTime;

  // scale initial grid to -1..1
  // vec2 p = (gl_FragCoord.xy / iResolution - 0.5) * 2.0;
  vec2 p = (gl_FragCoord.xy - iResolution.xy*0.5)/iResolution.y;

  // p.x -= camPos.x / 1.4 / abs(camPos.z);
  // p.y += camPos.y / abs(camPos.z);

  vec4 color = vec4(BLACK, 1.);

  vec3 ro = camPos;
  // vec3 target = normalize(vec3(0.,0.,-1.));
  vec3 target = cameraTarget;
  // vec3 up = vec3(0.,1.,0.);
  // vec3 right = normalize(cross(target,up));
  // vec3 rd = normalize((right*p.x + up*p.y)-target);

  vec3 forward = normalize(target - ro);
  vec3 right = -1.0 * normalize(cross(vec3(0.0, 1.0, 0.0), forward));
  vec3 up = -1.0 * normalize(cross(forward, right));

  vec3 rd = normalize(p.x * right + p.y * up + forward * fov);

  // vec4 outCol = vec4(0.);
  float d = 0.;
  vec4 result = vec4(0.);
  render(ro, rd, result, d);
  // color.rgb = outCol.rgb;

  if (d == 0.0) {
    gl_FragColor = vec4(BLACK,1.0);
    // gl_FragColor = grid(p, vec4(BLACK,0.1));
    return;
  }
  color.rgb = result.rgb;
  color.rgb *= lambert(WHITE, ro+rd*d, ro);
  // color.r = 1.0;
  gl_FragColor = color;
}
